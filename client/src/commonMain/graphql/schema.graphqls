schema {
    query: QueryType
}

type QueryType {
    stop(id: String!): Stop
    stops(ids: [String], name: String): [Stop]
    station(id: String!): Stop
    stations(ids: [String], name: String): [Stop]
    trip(id: String!): Trip
    planConnection(
        dateTime: PlanDateTimeInput,
        origin: PlanLabeledLocationInput!,
        destination: PlanLabeledLocationInput!,
        via: [PlanViaLocationInput!],
        first: Int,
        last: Int,
        before: String,
        after: String
    ): PlanConnection
}

scalar OffsetDateTime
scalar Duration
scalar Long

type Stop {
    gtfsId: String!
    name: String!
    lat: Float
    lon: Float
    wheelchairBoarding: WheelchairBoarding
    stoptimesWithoutPatterns(
        numberOfDepartures: Int,
        startTime: Long,
        timeRange: Int,
        omitNonPickups: Boolean,
    ): [Stoptime!]!
}

enum WheelchairBoarding {
    NO_INFORMATION
    POSSIBLE
    NOT_POSSIBLE
}

enum BikesAllowed {
    NO_INFORMATION
    ALLOWED
    NOT_ALLOWED
}

type Stoptime {
    serviceDay: Long
    scheduledArrival: Int
    scheduledDeparture: Int
    realtimeArrival: Int
    realtimeDeparture: Int
    realtime: Boolean
    realtimeState: RealtimeState
    headsign: String
    trip: Trip
    stop: Stop
}

type Trip {
    gtfsId: String!
    route: Route!
    tripHeadsign(language: String): String
    directionId: String
    bikesAllowed: BikesAllowed
    stoptimes: [Stoptime!]
    stoptimesForDate(serviceDate: String): [Stoptime!]
    tripGeometry: Geometry
}

enum RealtimeState {
    SCHEDULED
    UPDATED
    CANCELED
    ADDED
    MODIFIED
}

input PlanDateTimeInput {
    earliestDeparture: OffsetDateTime
    latestArrival: OffsetDateTime
}

input PlanLabeledLocationInput {
    label: String
    location: PlanLocationInput!
}

input PlanLocationInput {
    stopLocation: PlanStopLocationInput
    coordinate: PlanCoordinateInput
}

input PlanStopLocationInput {
    stopLocationId: String!
}

input PlanCoordinateInput {
    latitude: Float!
    longitude: Float!
}

input PlanViaLocationInput {
    passThrough: PlanPassThroughViaLocationInput
    visit: PlanVisitViaLocationInput
}

input PlanVisitViaLocationInput {
    label: String
    minimumWaitTime: Duration
    stopLocationIds: [String!]
    coordinate: PlanCoordinateInput
}

input PlanPassThroughViaLocationInput {
    label: String
    stopLocationIds: [String!]!
}

type PlanConnection {
    edges: [PlanEdge]
    pageInfo: PlanPageInfo!
    routingErrors: [RoutingError!]!
    searchDateTime: OffsetDateTime
}

type PlanEdge {
    cursor: String!
    node: Itinerary!
}

type PlanPageInfo {
    startCursor: String
    endCursor: String
    hasNextPage: Boolean!
    hasPreviousPage: Boolean!
    searchWindowUsed: Duration
}

type RoutingError {
    code: RoutingErrorCode!
    description: String!
    inputField: InputField
}

enum RoutingErrorCode {
    LOCATION_NOT_FOUND
    NO_STOPS_IN_RANGE
    NO_TRANSIT_CONNECTION
    NO_TRANSIT_CONNECTION_IN_SEARCH_WINDOW
    OUTSIDE_BOUNDS
    OUTSIDE_SERVICE_PERIOD
    SYSTEM_ERROR
    WALKING_BETTER_THAN_TRANSIT
}

enum InputField {
    DATE_TIME
    FROM
    TO
}

type Itinerary {
    start: OffsetDateTime
    end: OffsetDateTime
    duration: Long!
    waitingTime: Long
    numberOfTransfers: Int!
    accessibilityScore: Float
    legs: [Leg]!
}

type Leg {
    mode: Mode
    start: LegTime!
    end: LegTime!
    from: Place!
    to: Place!
    route: Route
    headsign: String
    distance: Float
    duration: Float
    accessibilityScore: Float
    trip: Trip
    legGeometry: Geometry
}

type Geometry {
    length: Int
    points: String
}

type LegTime {
    scheduledTime: OffsetDateTime!
}

type Place {
    name: String
    lat: Float
    lon: Float
    stop: Stop
}

type Route {
    shortName: String
    longName: String
    mode: TransitMode
}

enum Mode {
    WALK
    BUS
    RAIL
    SUBWAY
    TRAM
    FERRY
    TRANSIT
}

enum TransitMode {
    AIRPLANE
    BUS
    CABLE_CAR
    CARPOOL
    COACH
    FERRY
    FUNICULAR
    GONDOLA
    MONORAIL
    RAIL
    SNOW_AND_ICE
    SUBWAY
    TAXI
    TRAM
    TROLLEYBUS
}
